else 'Normal' 
END as remark from ( 
SELECT b.tablespace, 
 round(sum((b.blocks*p.value)/1024/1024/1024),2) AS Used_GB, 
 a.inst_id as Inst, 
 a.qcsid||','||qcserial# AS sid_serial, 
 NVL(a.username, '(oracle)') AS username, 
 module, 
 a.sql_id, 
  Ts_Size_GB 
FROM (select b.inst_id,b.saddr,nvl(a.qcsid,b.sid) qcsid,nvl(a.qcserial#,b.serial#) qcserial#,b.sid,b.serial#,nvl(a.degree,0) degree,b.program,b.module,b.logon_time,b.sql_id,b.username,b.status 
from gv$px_session a, gv$session b 
where a.inst_id(+)=b.inst_id 
and a.sid(+)=b.sid 
and a.serial#(+)=b.serial# 
and a.saddr(+)=b.saddr 
) a, 
 gv$sort_usage b, 
 gv$parameter p, 
(select b.name,a.ts_size_gb from (select TS#,round(sum(BYTES)/1024/1024/1024,2) Ts_Size_GB 
