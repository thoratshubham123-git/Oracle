Tablesapce utilization:

SELECT 
 df.tablespace_name, 
 ROUND(SUM(df.bytes) / POWER(1024, 3), 2) 
 AS allocated_gb, 
 ROUND( 
 SUM(df.bytes - NVL(fs.free_bytes, 0)) 
 / POWER(1024, 3), 2 
 ) AS used_gb, 
 ROUND( 
 SUM(NVL(fs.free_bytes, 0)) 
 / POWER(1024, 3), 2 
 ) AS free_gb, 
 ROUND( 
 (SUM(df.bytes - NVL(fs.free_bytes, 0)) 
 / NULLIF(SUM(df.bytes), 0)) * 100, 2 
 ) AS used_pct, 
 ROUND(SUM( 
 CASE WHEN df.autoextensible = 'YES' 
 THEN GREATEST(df.maxbytes - df.bytes, 0) 
 ELSE 0 
 END 
 ) / POWER(1024, 3), 2) AS remaining_growth_gb, 
 ROUND(SUM( 
 CASE WHEN df.autoextensible = 'YES' 
 THEN df.maxbytes 
 ELSE df.bytes 
 END 
 ) / POWER(1024, 3), 2) AS max_capacity_gb, 
 COUNT(*) AS datafile_count, 
 LISTAGG(DISTINCT df.autoextensible, ', ') 
 WITHIN GROUP (ORDER BY df.autoextensible) 
 AS autoextend_status, 
 ROUND( 
 SUM(CASE WHEN df.autoextensible = 'YES' 
 THEN df.increment_by * ts.block_size 
 ELSE 0 
 END) / POWER(1024, 3), 4 
 ) AS total_next_gb 
FROM dba_data_files df 
JOIN dba_tablespaces ts 
 ON ts.tablespace_name = df.tablespace_name 
LEFT JOIN ( 
 SELECT 
 file_id, 
 SUM(bytes) AS free_bytes 
 FROM dba_free_space 
 GROUP BY file_id 
) fs 
 ON fs.file_id = df.file_id 
GROUP BY df.tablespace_name 
ORDER BY used_pct DESC;




