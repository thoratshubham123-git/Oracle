col SESSION_DATA for a20 
set line 230 pages 1000 
col OSUSER for a20 
col MACHINE for a25 
col USERNAME for a25 
col TABLESPACE for a20 
col program for a25 
select * from 
( 
SELECT 
a.inst_id || '-' || a.sid||','||a.serial# AS session_data, 
NVL(a.username, '(oracle)') AS username, 
a.status, 
ROUND(((b.blocks*p.value)/1024/1024/1024),2) "GB_USED", 
b.tablespace, 
a.machine, 
a.program, 
a.osuser, 
a.sql_id 
FROM 
gv$session a, 
gv$sort_usage b, 
gv$parameter p 
WHERE 
p.name = 'db_block_size' 
AND a.saddr = b.session_addr 
AND a.inst_id=b.inst_id 
AND a.inst_id=p.inst_id 
ORDER BY 
ROUND(((b.blocks*p.value)/1024/1024/1024),2) desc 
) 
where rownum<21; 

